# TripPulse Backend Configuration
PROJECT_NAME="AI-Powered Intelligent Trip Planner"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-ai-trip-planner-antigravity-2026-jwt"
DATABASE_URL="sqlite:///./trip_planner.db"

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID with Application Type = "Web application"
# Authorized JavaScript origins: http://localhost:5174, http://127.0.0.1:5174
# Authorized redirect URIs: http://localhost:5174/login, http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5174/login"

# SMTP Email Configuration (Optional - for Welcome & Password Reset Confirmation Emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="notifications@trippulse.app"
EMAILS_FROM_NAME="TripPulse Team"

# External Weather & Maps (Optional - graceful fallbacks active)
OPENWEATHER_API_KEY=""
GOOGLE_MAPS_API_KEY=""
AI_API_KEY=""
