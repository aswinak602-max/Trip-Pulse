# ===================================================
# TripPulse Backend Configuration
# ===================================================
PROJECT_NAME="AI-Powered Intelligent Trip Planner"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-ai-trip-planner-antigravity-2026-jwt"
DATABASE_URL="sqlite:///./trip_planner.db"

# ===================================================
# Frontend & CORS Origins (Required for Cloud Hosting)
# ===================================================
# In production on Render/Railway/Fly.io, set FRONTEND_URL to your Vercel URL:
# FRONTEND_URL="https://trippulse.vercel.app"
FRONTEND_URL="http://localhost:5174"

# Additional comma-separated CORS allowed origins if needed:
# BACKEND_CORS_ORIGINS="https://trip-pulse-pi.vercel.app,http://localhost:5174,http://127.0.0.1:5174"
BACKEND_CORS_ORIGINS="https://trip-pulse-pi.vercel.app,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173"

# ===================================================
# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# ===================================================
# Create an OAuth 2.0 Client ID with Application Type = "Web application"
# Authorized JavaScript origins: http://localhost:5174, https://<your-vercel-app>.vercel.app
# Authorized redirect URIs: http://localhost:5174/login, https://<your-vercel-app>.vercel.app/login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5174/login"

# ===================================================
# SMTP Email Configuration (For Forgot Password OTP Delivery)
# ===================================================
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Set your Gmail address and 16-character App Password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-gmail-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_USE_TLS=true
EMAILS_FROM_NAME="TripPulse Team"

# ===================================================
# External APIs (Optional - graceful fallbacks active)
# ===================================================
OPENWEATHER_API_KEY=""
GOOGLE_MAPS_API_KEY=""
AI_API_KEY=""
