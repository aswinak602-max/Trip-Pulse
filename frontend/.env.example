# ===================================================
# TripPulse Frontend Environment Configuration
# ===================================================

# Backend API Base URL
# - Local Development: http://localhost:8000
# - Production (Vercel Project Settings > Environment Variables):
#   VITE_API_URL=https://<your-backend-host>.onrender.com
# Note: Do NOT add trailing slashes or /api/v1 - client.js automatically normalizes the path.
VITE_API_URL="http://localhost:8000"

# Google OAuth 2.0 Web Client ID (Must match backend GOOGLE_CLIENT_ID)
# From Google Cloud Console: APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=""
